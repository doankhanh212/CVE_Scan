    "iso_27001": "A.13.1",
    "type": "Preventive",
    "action": "Triển khai WAF để lọc và ngăn chặn các payload tấn công ứng dụng web phổ biến (SQLi, XSS, CSRF) ngay tại cửa ngõ."
  },
  "SC-7": {
    "keywords": [
      "firewall", "waf", "ngfw", "ips", "ids", "proxy", "reverse proxy", 
